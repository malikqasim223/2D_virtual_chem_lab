  void startEffectDrag(LabEffect effect, Offset pos) {
    draggingEffect = effect;
    dragPos = pos;
    dragOverlay?.remove();
    dragOverlay = OverlayEntry(builder: (_) => Positioned(
      left: dragPos.dx - 22, top: dragPos.dy - 22,
