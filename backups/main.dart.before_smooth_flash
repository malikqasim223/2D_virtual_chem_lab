}

class MiniBottlePainter extends CustomPainter {
  final Color color;
  final String state;
  MiniBottlePainter({required this.color, this.state = 'Liquid'});

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width, h = size.height;
    final isLiquid = state == 'Liquid' || state == 'Indicator';
    final isSolid = state == 'Solid';

    // Cap (brown for liquids, silver for solids)
    final capCol = isLiquid
        ? const Color(0xFF8B6A3F)
        : const Color(0xFF9E9E9E);
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(w * 0.30, 0, w * 0.40, h * 0.12),
        const Radius.circular(2)),
      Paint()..color = capCol);
    canvas.drawRect(
      Rect.fromLTWH(w * 0.30, h * 0.02, w * 0.40, h * 0.02),
      Paint()..color = Colors.white.withValues(alpha: 0.25));

    // Neck (narrow)
    canvas.drawRect(
      Rect.fromLTWH(w * 0.38, h * 0.12, w * 0.24, h * 0.08),
      Paint()..color = const Color(0xFFE0E4E8).withValues(alpha: 0.25));

    // Bottle body (rounded shoulders)
    final body = RRect.fromRectAndCorners(
      Rect.fromLTWH(w * 0.14, h * 0.20, w * 0.72, h * 0.76),
      topLeft: const Radius.circular(8),
      topRight: const Radius.circular(8),
      bottomLeft: const Radius.circular(3),
      bottomRight: const Radius.circular(3));
    canvas.drawRRect(body,
      Paint()..color = const Color(0xFFF5F7FA).withValues(alpha: 0.10));

    canvas.save();
    canvas.clipRRect(body);

    if (isLiquid) {
      // Liquid fill (60% from bottom)
      final fillTop = h * 0.20 + h * 0.76 * 0.40;
      final rect = Rect.fromLTWH(w * 0.14, fillTop, w * 0.72, h * 0.76 * 0.60);
      canvas.drawRect(rect, Paint()
        ..shader = LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [
            color.withValues(alpha: 0.50),
            color.withValues(alpha: 0.75),
            color.withValues(alpha: 0.95),
          ],
          stops: const [0.0, 0.5, 1.0],
        ).createShader(rect));
      // Meniscus curve
      final meniscus = Path()
        ..moveTo(w * 0.14, fillTop)
        ..quadraticBezierTo(w * 0.50, fillTop + 3, w * 0.86, fillTop);
      canvas.drawPath(meniscus, Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.2
        ..color = Colors.white.withValues(alpha: 0.7));
      // Small bubbles in liquid
      final rng = Random(color.toARGB32());
      for (int i = 0; i < 4; i++) {
        final bx = w * 0.22 + rng.nextDouble() * w * 0.56;
        final by = fillTop + 4 + rng.nextDouble() * (h * 0.94 - fillTop - 4);
        canvas.drawCircle(Offset(bx, by), 0.6 + rng.nextDouble() * 0.8,
          Paint()..color = Colors.white.withValues(alpha: 0.35));
      }
    } else if (isSolid) {
      // Crystal pile (polygonal shapes)
      final pileTop = h * 0.68;
      final rng = Random(color.toARGB32());
      // Base mound
      final mound = Path()
        ..moveTo(w * 0.14, h * 0.96)
        ..quadraticBezierTo(w * 0.30, pileTop - 4, w * 0.50, pileTop)
        ..quadraticBezierTo(w * 0.70, pileTop - 4, w * 0.86, h * 0.96)
        ..lineTo(w * 0.14, h * 0.96)
        ..close();
      canvas.drawPath(mound, Paint()
        ..shader = LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [
            color.withValues(alpha: 0.70),
            color.withValues(alpha: 1.0),
          ]).createShader(Rect.fromLTWH(0, pileTop - 4, w, h - pileTop + 4)));
      // Individual crystal shapes (diamonds/squares)
      for (int i = 0; i < 10; i++) {
        final cx = w * 0.20 + rng.nextDouble() * w * 0.60;
        final distFromCenter = ((cx - w * 0.5).abs() / (w * 0.36)).clamp(0.0, 1.0);
        final topY = pileTop + distFromCenter * 6;
        final cy = topY + rng.nextDouble() * (h * 0.94 - topY);
        final cs = 1.2 + rng.nextDouble() * 1.8;
        // Diamond shape
        final crystal = Path()
          ..moveTo(cx, cy - cs)
          ..lineTo(cx + cs * 0.7, cy)
          ..lineTo(cx, cy + cs)
          ..lineTo(cx - cs * 0.7, cy)
          ..close();
        canvas.drawPath(crystal, Paint()
          ..color = color.withValues(alpha: 0.85 + rng.nextDouble() * 0.15));
        canvas.drawPath(crystal, Paint()
          ..style = PaintingStyle.stroke
          ..strokeWidth = 0.3
          ..color = Colors.white.withValues(alpha: 0.5));
      }
      // Sparkle highlights
      for (int i = 0; i < 4; i++) {
        final sx = w * 0.22 + rng.nextDouble() * w * 0.56;
        final sy = pileTop + rng.nextDouble() * (h * 0.94 - pileTop);
        canvas.drawCircle(Offset(sx, sy), 0.6,
          Paint()..color = Colors.white.withValues(alpha: 0.9));
      }
    }
    canvas.restore();

    // Bottle glass outline
    canvas.drawRRect(body, Paint()
      ..color = const Color(0xFF6B7280).withValues(alpha: 0.55)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 0.9);

    // Glass shine (left)
    canvas.drawRect(
      Rect.fromLTWH(w * 0.20, h * 0.26, w * 0.04, h * 0.60),
      Paint()..color = Colors.white.withValues(alpha: 0.35));
    canvas.drawRect(
      Rect.fromLTWH(w * 0.19, h * 0.26, w * 0.015, h * 0.60),
      Paint()..color = Colors.white.withValues(alpha: 0.55));

    // Label band (small, for solid bottles)
    if (isSolid) {
      canvas.drawRect(
        Rect.fromLTWH(w * 0.20, h * 0.44, w * 0.60, h * 0.10),
        Paint()..color = Colors.white.withValues(alpha: 0.55));
      canvas.drawRect(
        Rect.fromLTWH(w * 0.22, h * 0.46, w * 0.56, h * 0.02),
        Paint()..color = color.withValues(alpha: 0.7));
    }
  }

  @override
  bool shouldRepaint(covariant MiniBottlePainter old) =>
      old.color != color || old.state != state;
}
class IcePainter extends CustomPainter {
  final double time;
  IcePainter({required this.time});

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;
    final cx = w / 2;
    final cy = h / 2;

    canvas.drawCircle(Offset(cx, cy), w * 0.35,
      Paint()..shader = RadialGradient(colors: [
        const Color(0xFFB3E5FC).withValues(alpha: 0.30), Colors.transparent,
      ]).createShader(Rect.fromCircle(center: Offset(cx, cy), radius: w * 0.5)));

    final cubes = [
      [-w * 0.20, h * 0.15, 0.18, 0.0],
      [w * 0.22, h * 0.25, 0.15, 0.4],
      [0.0, 0.0, 0.20, -0.3],
    ];
    for (int i = 0; i < cubes.length; i++) {
      canvas.save();
      canvas.translate(cx + cubes[i][0], cy + cubes[i][1]);
      canvas.rotate(cubes[i][3] + sin(time * 0.8 + i) * 0.05);
      _drawIceCube(canvas, w * cubes[i][2], h * cubes[i][2]);
      canvas.restore();
    }

    for (int i = 0; i < 6; i++) {
      final angle = (i / 6) * pi * 2 + time * 0.3;
      final r = w * 0.4;
      final x = cx + cos(angle) * r;
      final y = cy + sin(angle) * r * 0.7;
      final sp = (sin(time * 3 + i) + 1) / 2;
      canvas.drawCircle(Offset(x, y), 1 + sp * 2,
        Paint()..color = Colors.white.withValues(alpha: sp * 0.8));
    }
  }

  void _drawIceCube(Canvas canvas, double cw, double ch) {
    final top = Path()
      ..moveTo(0, -ch * 0.5)..lineTo(cw * 0.5, -ch * 0.35)
      ..lineTo(0, -ch * 0.15)..lineTo(-cw * 0.5, -ch * 0.35)..close();
    canvas.drawPath(top, Paint()..color = const Color(0xFFE1F5FE).withValues(alpha: 0.9));
    final left = Path()
      ..moveTo(-cw * 0.5, -ch * 0.35)..lineTo(0, -ch * 0.15)
      ..lineTo(0, ch * 0.5)..lineTo(-cw * 0.5, ch * 0.35)..close();
    canvas.drawPath(left, Paint()..color = const Color(0xFF81D4FA).withValues(alpha: 0.8));
    final right = Path()
      ..moveTo(0, -ch * 0.15)..lineTo(cw * 0.5, -ch * 0.35)
      ..lineTo(cw * 0.5, ch * 0.35)..lineTo(0, ch * 0.5)..close();
    canvas.drawPath(right, Paint()..color = const Color(0xFF4FC3F7).withValues(alpha: 0.75));
    canvas.drawLine(Offset(-cw * 0.35, -ch * 0.35), Offset(-cw * 0.1, -ch * 0.2),
      Paint()..color = Colors.white.withValues(alpha: 0.8)
        ..strokeWidth = 1.4..strokeCap = StrokeCap.round);
  }

  @override
  bool shouldRepaint(covariant IcePainter old) => old.time != time;
}
class BenchToolPainter extends CustomPainter {
  final LabEffect type;
  final double time;
  BenchToolPainter({required this.type, required this.time});
  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width, h = size.height;
    switch (type) {
      case LabEffect.heat:
        canvas.drawOval(Rect.fromLTWH(w * 0.1, h * 0.82, w * 0.8, h * 0.15),
          Paint()..color = const Color(0xFF4B5563));
        canvas.drawRect(Rect.fromLTWH(w * 0.42, h * 0.3, w * 0.16, h * 0.5),
          Paint()..color = const Color(0xFF6B7280));
        break;
      case LabEffect.cool:
        canvas.drawCircle(Offset(w * 0.5, h * 0.5), w * 0.35,
          Paint()..color = const Color(0xFF6B92B8).withValues(alpha: 0.7));
        break;
      case LabEffect.stir:
        canvas.drawLine(Offset(w * 0.25, h * 0.85), Offset(w * 0.75, h * 0.15),
          Paint()..color = const Color(0xFFD8E3EC)..strokeWidth = 5..strokeCap = StrokeCap.round);
        break;
      case LabEffect.thermometer:
        canvas.drawRRect(RRect.fromRectAndRadius(
          Rect.fromLTWH(w * 0.42, h * 0.1, w * 0.16, h * 0.7), const Radius.circular(4)),
          Paint()..color = Colors.white);
        canvas.drawCircle(Offset(w * 0.5, h * 0.83), w * 0.13,
          Paint()..color = const Color(0xFFB85450));
        break;
      case LabEffect.dropper:
        canvas.drawCircle(Offset(w * 0.5, h * 0.22), w * 0.2,
          Paint()..color = const Color(0xFF6B7280));
        canvas.drawRect(Rect.fromLTWH(w * 0.42, h * 0.4, w * 0.16, h * 0.4),
          Paint()..color = Colors.white.withValues(alpha: 0.9));
        break;
    }
  }
  @override
  bool shouldRepaint(covariant BenchToolPainter old) => old.time != time;
}
