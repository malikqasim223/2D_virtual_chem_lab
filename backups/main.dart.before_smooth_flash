class HeatingSetupPainter extends CustomPainter {
  final double time;
  HeatingSetupPainter({required this.time});

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;
    final cx = w / 2;

    final ringY = h * 0.08;
    final ringW = w * 0.9;
    final ringH = h * 0.08;
    final benchY = h * 0.98;

    final legPaint = Paint()
      ..color = const Color(0xFF37474F)
      ..strokeWidth = 10
      ..strokeCap = StrokeCap.round;
    final legSpread = ringW * 0.42;
    canvas.drawLine(Offset(cx - legSpread, ringY + ringH * 0.4), Offset(cx - legSpread - w * 0.04, benchY), legPaint);
    canvas.drawLine(Offset(cx + legSpread, ringY + ringH * 0.4), Offset(cx + legSpread + w * 0.04, benchY), legPaint);
    canvas.drawLine(Offset(cx, ringY + ringH * 0.4), Offset(cx, benchY), legPaint);

    canvas.drawCircle(Offset(cx - legSpread - w * 0.04, benchY), 6, Paint()..color = const Color(0xFF263238));
    canvas.drawCircle(Offset(cx + legSpread + w * 0.04, benchY), 6, Paint()..color = const Color(0xFF263238));
    canvas.drawCircle(Offset(cx, benchY), 6, Paint()..color = const Color(0xFF263238));

    canvas.drawOval(
      Rect.fromCenter(center: Offset(cx, ringY + ringH / 2), width: ringW, height: ringH),
      Paint()
        ..color = const Color(0xFF37474F)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 9,
    );

    final gY1 = ringY + ringH * 0.25;
    final gY2 = ringY + ringH * 0.75;
    final gauzePaint = Paint()
      ..color = const Color(0xFFB0BEC5)
      ..strokeWidth = 1.0;
    for (int i = 0; i < 3; i++) {
      final y = gY1 + (gY2 - gY1) * i / 2;
      canvas.drawLine(Offset(cx - ringW * 0.42, y), Offset(cx + ringW * 0.42, y), gauzePaint);
    }
    for (int i = 0; i < 10; i++) {
      final x = cx - ringW * 0.42 + (ringW * 0.84) * i / 9;
      canvas.drawLine(Offset(x, gY1), Offset(x, gY2), gauzePaint);
    }

    canvas.drawOval(
      Rect.fromCenter(center: Offset(cx, h * 0.93), width: w * 0.42, height: h * 0.07),
      Paint()..color = const Color(0xFF2C3E50),
    );
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromCenter(center: Offset(cx, h * 0.88), width: w * 0.36, height: h * 0.10),
        const Radius.circular(6),
      ),
      Paint()..color = const Color(0xFF455A64),
    );

    final tubeTop = h * 0.48;
    final tubeBot = h * 0.84;
    canvas.drawRect(
      Rect.fromLTRB(cx - w * 0.055, tubeTop, cx + w * 0.055, tubeBot),
      Paint()..color = const Color(0xFFB0BEC5),
    );
    canvas.drawRect(
      Rect.fromLTRB(cx - w * 0.045, tubeTop, cx - w * 0.02, tubeBot),
      Paint()..color = Colors.white.withValues(alpha: 0.4),
    );

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTRB(cx - w * 0.09, h * 0.58, cx + w * 0.09, h * 0.66),
        const Radius.circular(3),
      ),
      Paint()..color = const Color(0xFF263238),
    );

    canvas.drawCircle(Offset(cx + w * 0.16, h * 0.63), w * 0.04, Paint()..color = const Color(0xFF546E7A));
    canvas.drawCircle(Offset(cx + w * 0.16, h * 0.63), w * 0.018, Paint()..color = const Color(0xFF263238));

    final hose = Path()
      ..moveTo(cx + w * 0.16, h * 0.63)
      ..cubicTo(cx + w * 0.40, h * 0.68, cx + w * 0.46, h * 0.94, cx + w * 0.18, h * 0.96);
    canvas.drawPath(hose, Paint()
      ..color = const Color(0xFFB71C1C)
      ..strokeWidth = 4
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round);

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTRB(cx - w * 0.065, h * 0.44, cx + w * 0.065, h * 0.50),
        const Radius.circular(2),
      ),
      Paint()..color = const Color(0xFF78909C),
    );

    final fy = h * 0.45;
    final fh = h * 0.30;
    final f1 = sin(time * 6) * 1.0;
    final f2 = sin(time * 9 + 1.3) * 0.8;

    final outer = Path()
      ..moveTo(cx - w * 0.075, fy)
      ..quadraticBezierTo(cx - w * 0.10 + f1, fy - fh * 0.5, cx + f2, fy - fh)
      ..quadraticBezierTo(cx + w * 0.10 + f1, fy - fh * 0.5, cx + w * 0.075, fy)
      ..close();
    canvas.drawPath(outer, Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: const [
          Color(0xFFFFF8E1),
          Color(0xFFFFD54F),
          Color(0xFFFF9800),
          Color(0xFFE64A19),
        ],
        stops: const [0.0, 0.35, 0.7, 1.0],
      ).createShader(Rect.fromLTRB(cx - w*0.12, fy - fh, cx + w*0.12, fy)));

    final core = Path()
      ..moveTo(cx - w * 0.032, fy - fh * 0.02)
      ..quadraticBezierTo(cx - w * 0.042, fy - fh * 0.35, cx, fy - fh * 0.55)
      ..quadraticBezierTo(cx + w * 0.042, fy - fh * 0.35, cx + w * 0.032, fy - fh * 0.02)
      ..close();
    canvas.drawPath(core, Paint()..color = const Color(0xFF81D4FA));
  }

  @override
  bool shouldRepaint(covariant HeatingSetupPainter old) => old.time != time;
}

class MarbleBenchPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    canvas.drawRect(Offset.zero & size, Paint()
      ..shader = const LinearGradient(begin: Alignment.topCenter, end: Alignment.bottomCenter,
        colors: [LC.marbleHighlight, LC.marbleBase]).createShader(Offset.zero & size));
    final rng = Random(42);
    for (int i = 0; i < 60; i++) {
      final start = Offset(rng.nextDouble() * size.width, rng.nextDouble() * size.height);
      final len = 50 + rng.nextDouble() * 200;
      final angle = rng.nextDouble() * pi;
      canvas.drawLine(start, Offset(start.dx + cos(angle) * len, start.dy + sin(angle) * len),
        Paint()..color = Colors.white.withValues(alpha: 0.03)..strokeWidth = 0.8);
    }
    for (int i = 0; i < 400; i++) {
      canvas.drawCircle(Offset(rng.nextDouble() * size.width, rng.nextDouble() * size.height),
        0.3 + rng.nextDouble() * 0.6,
        Paint()..color = (rng.nextBool() ? Colors.white : Colors.black).withValues(alpha: 0.04));
    }
  }
  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class RealisticEquipPainter extends CustomPainter {
  final EquipShape shape;
  final EquipItem item;
  final bool isHovered;
  final double time;
  final ReactionInfo? reaction;
  RealisticEquipPainter({required this.shape, required this.item,
    required this.isHovered, required this.time, required this.reaction});

  @override
  void paint(Canvas canvas, Size size) {
    final w = shape.size.width, h = shape.size.height;
    final ox = (size.width - w) / 2, oy = (size.height - h) / 2;
    canvas.save();
    canvas.translate(ox, oy);
    final path = _buildPath(w, h);

    canvas.drawOval(Rect.fromLTWH(w * 0.15, h * 0.96, w * 0.7, h * 0.05),
      Paint()..color = Colors.black.withValues(alpha: 0.6)
        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 10));

    canvas.drawPath(path, Paint()..shader = LinearGradient(
      begin: Alignment.topLeft, end: Alignment.bottomRight,
      colors: [LC.glassTint.withValues(alpha: 0.12),
        LC.glassFill.withValues(alpha: 0.06),
        LC.glassTint.withValues(alpha: 0.10)]).createShader(Rect.fromLTWH(0, 0, w, h)));

    canvas.save();
    canvas.clipPath(path);
    if (item.layers.isNotEmpty) {
      _paintSolidPile(canvas, w, h);
      _paintLayers(canvas, w, h);
      _paintWave(canvas, w, h);
      if (reaction?.bubbles == true) _paintBubbles(canvas, w, h);
      _paintHeatingEffect(canvas, w, h);
      _paintGasEvolution(canvas, w, h);
      _paintSmoke(canvas, w, h);
      _paintFireBlast(canvas, w, h);
      if (reaction?.precipitate == true) _paintPrecipitate(canvas, w, h, reaction!.colorChange ?? LC.glassFill);
      if (item.isStirring) _paintStir(canvas, w, h);
      if (item.isCold) _paintFrost(canvas, w, h);
    }
    canvas.restore();
    // Tools OUTSIDE glass clip so they are visible
    if (item.hasThermo) _paintThermometer(canvas, w, h);
    if (item.hasDropper) _paintDropper(canvas, w, h);

    canvas.drawPath(path, Paint()..style = PaintingStyle.stroke
      ..strokeWidth = isHovered ? 2 : 1.3..strokeJoin = StrokeJoin.round
      ..color = isHovered ? LC.success : LC.glassEdge.withValues(alpha: 0.6));

    _paintMarks(canvas, w, h);
    _paintPour(canvas, w, h);
    canvas.restore();
  }

  Path _buildPath(double w, double h) {
    final path = Path();
    switch (shape) {
      case EquipShape.beaker:
        path.moveTo(w * 0.08, h * 0.10);
        path.lineTo(w * 0.85, h * 0.10);
        path.lineTo(w * 0.95, h * 0.13);
        path.lineTo(w * 0.87, h * 0.16);
        path.lineTo(w * 0.91, h * 0.16);
        path.lineTo(w * 0.91, h * 0.90);
        path.quadraticBezierTo(w * 0.91, h * 0.95, w * 0.82, h * 0.95);
        path.lineTo(w * 0.18, h * 0.95);
        path.quadraticBezierTo(w * 0.09, h * 0.95, w * 0.09, h * 0.90);
        path.close();
        break;
      case EquipShape.flask:
        path.moveTo(w * 0.40, h * 0.06);
        path.lineTo(w * 0.60, h * 0.06);
        path.lineTo(w * 0.60, h * 0.30);
        path.quadraticBezierTo(w * 0.97, h * 0.58, w * 0.97, h * 0.85);
        path.quadraticBezierTo(w * 0.97, h * 0.95, w * 0.85, h * 0.95);
        path.lineTo(w * 0.15, h * 0.95);
        path.quadraticBezierTo(w * 0.03, h * 0.95, w * 0.03, h * 0.85);
        path.quadraticBezierTo(w * 0.03, h * 0.58, w * 0.40, h * 0.30);
        path.close();
        break;
      case EquipShape.testTube:
        path.moveTo(w * 0.20, h * 0.06);
        path.lineTo(w * 0.80, h * 0.06);
        path.lineTo(w * 0.83, h * 0.09);
        path.lineTo(w * 0.80, h * 0.10);
        path.lineTo(w * 0.80, h * 0.82);
        path.quadraticBezierTo(w * 0.80, h * 0.95, w * 0.5, h * 0.95);
        path.quadraticBezierTo(w * 0.20, h * 0.95, w * 0.20, h * 0.82);
        path.close();
        break;
      case EquipShape.cylinder:
        path.moveTo(w * 0.30, h * 0.06);
        path.lineTo(w * 0.70, h * 0.06);
        path.lineTo(w * 0.73, h * 0.09);
        path.lineTo(w * 0.70, h * 0.10);
        path.lineTo(w * 0.70, h * 0.85);
        path.lineTo(w * 0.92, h * 0.94);
        path.lineTo(w * 0.92, h * 0.96);
        path.lineTo(w * 0.08, h * 0.96);
        path.lineTo(w * 0.08, h * 0.94);
        path.lineTo(w * 0.30, h * 0.85);
        path.close();
        break;
    }
    return path;
  }

  void _paintLayers(Canvas canvas, double w, double h) {
    final slosh = sin(item.sloshPhase) * item.sloshAmp;
    final baseTop = h * (1 - 0.82 * item.fillRatio) - h * 0.03;

    // === REACTION COMPLETE: separated products ===
    if (item.reactionComplete && reaction != null) {
      // Real product colors based on reaction type
      final products = reaction!.products.join(' ').toLowerCase();
      Color waterCol = const Color(0xFFCFE8F0);
      Color saltCol = const Color(0xFFEDEDE5);
      Color? pptCol = reaction!.precipitateColor;
      if (pptCol != null) {
        saltCol = pptCol;
      }
      if (products.contains('cu')) { saltCol = const Color(0xFF3D7FA8); }
      if (products.contains('agcl')) { saltCol = const Color(0xFFF5F5F5); waterCol = const Color(0xFFE8F0F5); }
      if (products.contains('ag2so4')) { saltCol = const Color(0xFFEDEDED); }
      final splitY = h * 0.60;

      final waterPath = Path()
        ..moveTo(0, baseTop - slosh)
        ..lineTo(w, baseTop + slosh)
        ..lineTo(w, splitY)
        ..lineTo(0, splitY)
        ..close();
      canvas.drawPath(waterPath, Paint()
        ..shader = LinearGradient(
          begin: Alignment.topCenter, end: Alignment.bottomCenter,
          colors: [
            waterCol.withValues(alpha: 0.55),
            waterCol.withValues(alpha: 0.75),
          ],
        ).createShader(Rect.fromLTWH(0, baseTop - 2, w, splitY - baseTop + 2)));

      final saltPath = Path()
        ..moveTo(0, splitY)
        ..lineTo(w, splitY)
        ..lineTo(w, h)
        ..lineTo(0, h)
        ..close();
      canvas.drawPath(saltPath, Paint()
        ..shader = LinearGradient(
          begin: Alignment.topCenter, end: Alignment.bottomCenter,
          colors: [
            saltCol.withValues(alpha: 0.85),
            saltCol.withValues(alpha: 0.95),
          ],
        ).createShader(Rect.fromLTWH(0, splitY, w, h - splitY)));

      final rng = Random(item.id.length * 3 + 11);
      for (int i = 0; i < 45; i++) {
        final px = rng.nextDouble() * w;
        final py = splitY + rng.nextDouble() * (h - splitY);
        canvas.drawCircle(Offset(px, py),
          0.5 + rng.nextDouble() * 1.1,
          Paint()..color = Colors.white.withValues(alpha: 0.55));
      }

      final splitLine = Path()
        ..moveTo(0, splitY)
        ..quadraticBezierTo(w * 0.5, splitY + 2, w, splitY);
      canvas.drawPath(splitLine, Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.5
        ..color = Colors.white.withValues(alpha: 0.7));

      return;
    }

    // === NORMAL: mixed liquid ===
    Color blended = item.blendedColor;
    if (reaction?.colorChange != null) blended = reaction!.colorChange!;
    // Heat transform: CuSO4 (blue) -> anhydrous (white) at high temp
    if (item.isHeatedTransform && item.layers.any((l) => l.chemId == 'cuso4')) {
      blended = Color.lerp(blended, const Color(0xFFE8EDEF), ((item.temperature - 60) / 90).clamp(0.0, 0.9))!;
    }
    final path = Path()
      ..moveTo(0, baseTop - slosh)
      ..lineTo(w, baseTop + slosh)
      ..lineTo(w, h)
      ..lineTo(0, h)
      ..close();
    canvas.drawPath(path, Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter, end: Alignment.bottomCenter,
        colors: [
          blended.withValues(alpha: 0.5),
          blended.withValues(alpha: 0.75),
          blended.withValues(alpha: 0.9),
        ],
      ).createShader(Rect.fromLTWH(0, baseTop - 2, w, h - baseTop + 2)));
  }

  void _paintMarks(Canvas canvas, double w, double h) {
    // Shape-specific: major ticks (with numbers) + minor subdivisions
    final List<int> major;
    final List<int> minor;
    double yTop, yBot, rightX;
    int minorStep;

    switch (shape) {
      case EquipShape.beaker:
        major = [50, 100, 150, 200, 250];
        minorStep = 10;
        yTop = h * 0.15; yBot = h * 0.88; rightX = w * 0.86;
        break;
      case EquipShape.flask:
        major = [50, 100, 150, 200, 250];
        minorStep = 10;
        yTop = h * 0.42; yBot = h * 0.88; rightX = w * 0.70;
        break;
      case EquipShape.testTube:
        major = [10, 20, 30, 40, 50];
        minorStep = 2;
        yTop = h * 0.20; yBot = h * 0.86; rightX = w * 0.76;
        break;
      case EquipShape.cylinder:
        major = [20, 40, 60, 80, 100];
        minorStep = 5;
        yTop = h * 0.15; yBot = h * 0.84; rightX = w * 0.70;
        break;
    }

    final maxVol = major.last;
    final span = yBot - yTop;

    // Build minor list
    minor = <int>[];
    for (int v = minorStep; v < maxVol; v += minorStep) {
      if (!major.contains(v)) minor.add(v);
    }

    // === Minor ticks (thin, short) ===
    final minorPaint = Paint()
      ..color = Colors.white.withValues(alpha: 0.42)
      ..strokeWidth = 0.6
      ..strokeCap = StrokeCap.round;
    for (final v in minor) {
      final y = yBot - (v / maxVol) * span;
      canvas.drawLine(Offset(rightX - w * 0.045, y), Offset(rightX, y), minorPaint);
    }

    // === Major ticks (thick, long, with numbers) ===
    final majorPaint = Paint()
      ..color = Colors.white.withValues(alpha: 0.9)
      ..strokeWidth = 1.2
      ..strokeCap = StrokeCap.round;
    for (final v in major) {
      final y = yBot - (v / maxVol) * span;
      canvas.drawLine(Offset(rightX - w * 0.10, y), Offset(rightX, y), majorPaint);

      final tp = TextPainter(
        text: TextSpan(
          text: '$v',
          style: TextStyle(
            fontSize: 7.5,
            color: Colors.white.withValues(alpha: 0.92),
            fontWeight: FontWeight.w600,
            letterSpacing: 0.2,
          ),
        ),
        textDirection: TextDirection.ltr,
      )..layout();
      tp.paint(canvas, Offset(rightX - w * 0.10 - tp.width - 4, y - 4));
    }

    // Small "mL" label at bottom of scale (except test tube which uses mL too)
    final unitTp = TextPainter(
      text: TextSpan(
        text: 'mL',
        style: TextStyle(
          fontSize: 6,
          color: Colors.white.withValues(alpha: 0.65),
          fontWeight: FontWeight.w500,
          fontStyle: FontStyle.italic,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();
    unitTp.paint(canvas, Offset(rightX - unitTp.width - 2, yBot + 4));
  }



  void _paintWave(Canvas canvas, double w, double h) {
    final slosh = sin(item.sloshPhase) * item.sloshAmp;
    final baseTop = h * (1 - 0.82 * item.fillRatio) - h * 0.03;
    final amp = 1.5 + item.fillRatio * 1.5;
    final wavePath = Path()..moveTo(0, baseTop - slosh);
    for (double x = 0; x <= w; x += 2) {
      final tilt = ((x / w) - 0.5) * 2 * slosh;
      wavePath.lineTo(x, baseTop + tilt + sin((x / w) * pi * 3 + time * 3) * amp);
    }
    canvas.drawPath(wavePath, Paint()
      ..style = PaintingStyle.stroke..strokeWidth = 2
      ..color = Colors.white.withValues(alpha: 0.5));
  }

  void _paintBubbles(Canvas canvas, double w, double h) {
    final top = h * (1 - 0.82 * item.fillRatio) - h * 0.03;
    final rng = Random(42);
    for (int i = 0; i < 12; i++) {
      final bx = rng.nextDouble() * w;
      final speed = 0.3 + rng.nextDouble() * 0.4;
      final progress = (time * speed + rng.nextDouble()) % 1.0;
      final by = h - progress * (h - top);
      final r = 1.5 + rng.nextDouble() * 2.5;
      canvas.drawCircle(Offset(bx, by), r,
        Paint()..color = Colors.white.withValues(alpha: 0.4));
      canvas.drawCircle(Offset(bx, by), r,
        Paint()..style = PaintingStyle.stroke..strokeWidth = 0.6
          ..color = Colors.white.withValues(alpha: 0.7));
    }
  }

  void _paintPrecipitate(Canvas canvas, double w, double h, Color color) {
    final pHeight = h * 0.18;
    final rect = Rect.fromLTWH(0, h - pHeight, w, pHeight);
    canvas.drawRect(rect, Paint()
      ..shader = LinearGradient(begin: Alignment.topCenter, end: Alignment.bottomCenter,
        colors: [color.withValues(alpha: 0.35), color.withValues(alpha: 0.85)])
      .createShader(rect));
    final rng = Random(21);
    for (int i = 0; i < 25; i++) {
      canvas.drawCircle(Offset(rng.nextDouble() * w, h - rng.nextDouble() * pHeight),
        0.8 + rng.nextDouble() * 1.5,
        Paint()..color = color.withValues(alpha: 0.7));
    }
  }

  void _paintStir(Canvas canvas, double w, double h) {
    // Rotating stirrer rod
    final cx = w * 0.5 + sin(time * 5) * w * 0.12;
    final cy = h * 0.50;

    // Rotation ripple circles
    for (int i = 0; i < 3; i++) {
      canvas.drawCircle(
        Offset(cx, cy),
        w * (0.10 + i * 0.06),
        Paint()
          ..style = PaintingStyle.stroke
          ..strokeWidth = 0.8
          ..color = Colors.white.withValues(alpha: 0.35 - i * 0.08));
    }

    // Glass rod
    final rodTop = Offset(cx + sin(time * 2) * w * 0.02, h * 0.05);
    final rodBot = Offset(cx + sin(time * 4) * w * 0.05, h * 0.88);
    canvas.drawLine(rodTop, rodBot,
      Paint()
        ..color = Colors.white.withValues(alpha: 0.9)
        ..strokeWidth = 3.5
        ..strokeCap = StrokeCap.round);

    // Highlight on rod
    canvas.drawLine(
      Offset(rodTop.dx - 0.8, rodTop.dy),
      Offset(rodBot.dx - 0.8, rodBot.dy),
      Paint()
        ..color = Colors.white.withValues(alpha: 0.6)
        ..strokeWidth = 1
        ..strokeCap = StrokeCap.round);

    // Bottom paddle
    canvas.drawOval(
      Rect.fromCenter(center: rodBot, width: 18, height: 6),
      Paint()..color = Colors.white.withValues(alpha: 0.85));
  }

  void _paintFrost(Canvas canvas, double w, double h) {
    canvas.drawRect(
      Rect.fromLTWH(0, h * 0.60, w, h * 0.40),
      Paint()..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [
          Colors.transparent,
          const Color(0xFFB3E5FC).withValues(alpha: 0.35),
          const Color(0xFF81D4FA).withValues(alpha: 0.60),
        ],
        stops: const [0.0, 0.6, 1.0],
      ).createShader(Rect.fromLTWH(0, h * 0.60, w, h * 0.40)));
    final rng = Random(42);
    for (int i = 0; i < 18; i++) {
      final x = rng.nextDouble() * w;
      final y = h - rng.nextDouble() * h * 0.25;
      final r = 1.5 + rng.nextDouble() * 3.0;
      canvas.drawCircle(Offset(x, y), r,
        Paint()..color = Colors.white.withValues(alpha: 0.8));
      canvas.drawCircle(Offset(x, y), r * 2.2,
        Paint()..style = PaintingStyle.stroke..strokeWidth = 0.5
          ..color = const Color(0xFFB3E5FC).withValues(alpha: 0.75));
    }
    for (int i = 0; i < 30; i++) {
      final x = rng.nextDouble() * w;
      final y = rng.nextDouble() * h * 0.4;
      canvas.drawCircle(Offset(x, y), 0.5 + rng.nextDouble() * 1.3,
        Paint()..color = Colors.white.withValues(alpha: 0.65));
    }
  }

  void _paintFireBlast(Canvas canvas, double w, double h) {
    if (reaction == null || !reaction!.isViolent) return;
    // === PERSISTENT STATE (after reaction complete) ===
    // Fire continues like boiling water + light smoke
    if (item.reactionComplete && item.reactionProgress >= 1.0) {
      final rng = Random(42);
      final cx = w * 0.5;
      final baseY = h * 0.90;
      final maxHeight = h * 0.70;

      // === BOILING FIRE (persistent, simmering) ===
      // Main flame - continuous
      _drawRealFlame(canvas, cx, baseY, w * 0.22, maxHeight * 0.75, 0.85, rng, time);
      // Side flames
      _drawRealFlame(canvas, cx - w * 0.15, baseY, w * 0.13, maxHeight * 0.55, 0.7, rng, time + 1.3);
      _drawRealFlame(canvas, cx + w * 0.15, baseY, w * 0.13, maxHeight * 0.55, 0.7, rng, time + 2.7);
      // Small outer flames
      _drawRealFlame(canvas, cx - w * 0.25, baseY, w * 0.08, maxHeight * 0.35, 0.5, rng, time + 4.1);
      _drawRealFlame(canvas, cx + w * 0.25, baseY, w * 0.08, maxHeight * 0.35, 0.5, rng, time + 5.5);

      // === BOILING BUBBLES (inside liquid) ===
      for (int i = 0; i < 18; i++) {
        final seed = rng.nextDouble();
        final bx = cx + (rng.nextDouble() - 0.5) * w * 0.7;
        final prog = ((time * 0.8 + seed) % 1.0);
        final by = baseY - prog * h * 0.5;
        final bs = 2 + (1 - prog) * 4;
        final ba = (1 - prog) * 0.7;
        // Bubble outer
        canvas.drawCircle(Offset(bx, by), bs, Paint()
          ..style = PaintingStyle.stroke
          ..strokeWidth = 1.2
          ..color = const Color(0xFFFFEB3B).withValues(alpha: ba));
        // Bubble fill (small)
        canvas.drawCircle(Offset(bx, by), bs * 0.4, Paint()
          ..color = Colors.white.withValues(alpha: ba * 0.8));
      }

      // === RISING EMBERS (like steam particles) ===
      for (int i = 0; i < 15; i++) {
        final seed = rng.nextDouble();
        final ex = cx + (rng.nextDouble() - 0.5) * w * 0.6;
        final prog = ((time * 1.2 + seed) % 1.0);
        final ey = baseY - prog * maxHeight * 1.1;
        final es = 1.2 + (1 - prog) * 2.5;
        final ea = (1 - prog) * 0.9;
        canvas.drawCircle(Offset(ex, ey), es * 2, Paint()
          ..color = const Color(0xFFFF4500).withValues(alpha: ea * 0.35)
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 3));
        canvas.drawCircle(Offset(ex, ey), es, Paint()
          ..color = const Color(0xFFFFEB3B).withValues(alpha: ea));
      }

      // === BASE GLOW (heat source) ===
      canvas.drawCircle(Offset(cx, baseY), w * 0.30, Paint()
        ..shader = RadialGradient(colors: [
          const Color(0xFFFF6B00).withValues(alpha: 0.75),
          const Color(0xFFFF4500).withValues(alpha: 0.35),
          Colors.transparent,
        ]).createShader(Rect.fromCircle(center: Offset(cx, baseY), radius: w * 0.30))
        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 15));

      // === LIGHT SMOKE (thinner, less dense than before) ===
      for (int i = 0; i < 10; i++) {
        final seed = rng.nextDouble();
        final sx = cx + (rng.nextDouble() - 0.5) * w * 0.7;
        final prog = ((time * 0.35 + seed) % 1.0);
        final sy = h * 0.4 - prog * h * 0.5;
        final ss = 18 + prog * 30;
        final sa = sin(prog * 3.14159) * 0.35;
        final sway = sin(time * 1.2 + seed * 6) * 8;
        canvas.drawCircle(Offset(sx + sway, sy), ss, Paint()
          ..shader = RadialGradient(colors: [
            const Color(0xFF5A5A5A).withValues(alpha: sa),
            const Color(0xFF3A3A3A).withValues(alpha: sa * 0.5),
            Colors.transparent,
          ]).createShader(Rect.fromCircle(center: Offset(sx + sway, sy), radius: ss))
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 12));
      }

      return;
    }

    final rng = Random(42);
    final progress = item.reactionProgress;
    final cx = w * 0.5;
    final cy = h * (1 - 0.82 * item.fillRatio) - h * 0.03; // liquid top level

    // PHASE 1 (0.0-0.25): REALISTIC EXPLOSION (gradient blobs)
    if (progress < 0.35) {
      final p = progress / 0.35;
      if (p < 0.2) {
        final pp = p / 0.2;
        final r = w * 0.04 + pp * w * 0.04;
        canvas.drawCircle(Offset(cx, cy), r * 4, Paint()
          ..color = const Color(0xFFFFEB3B).withValues(alpha: 0.5 * pp)
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 15));
        canvas.drawCircle(Offset(cx, cy), r * 1.5, Paint()
          ..color = const Color(0xFFFFF176).withValues(alpha: 0.9 * pp));
        canvas.drawCircle(Offset(cx, cy), r * 0.7, Paint()..color = Colors.white);
      } else if (p < 0.55) {
        final pp = (p - 0.2) / 0.35;
        final baseR = w * 0.08 + pp * w * 0.18;

        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]
        // [SMOKE REMOVED]

        // LAYER 2: Deep red (gradient + highlight)
        for (int i = 0; i < 16; i++) {
          final seed = i * 0.723;
          final ang = i * 3.14159 * 2 / 16 + 0.3;
          final distMult = 0.85 + (seed % 1) * 0.4;
          final dist = baseR * distMult;
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.9;
          final puffR = baseR * (0.42 + (seed % 1) * 0.3);
          canvas.drawCircle(Offset(bx, by), puffR, Paint()
            ..shader = RadialGradient(
              center: const Alignment(-0.3, -0.4),
              colors: [
                const Color(0xFFE53935).withValues(alpha: 0.95),
                const Color(0xFF8B0000).withValues(alpha: 0.95),
                const Color(0xFF4A0000).withValues(alpha: 0.7),
              ],
              stops: const [0.0, 0.5, 1.0],
            ).createShader(Rect.fromCircle(center: Offset(bx, by), radius: puffR)));
        }

        // LAYER 3: Bright red (with top highlight)
        for (int i = 0; i < 13; i++) {
          final seed = i * 0.517;
          final ang = i * 3.14159 * 2 / 13 + 0.6;
          final distMult = 0.65 + (seed % 1) * 0.35;
          final dist = baseR * distMult;
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.88;
          final puffR = baseR * (0.4 + (seed % 1) * 0.25);
          canvas.drawCircle(Offset(bx, by), puffR, Paint()
            ..shader = RadialGradient(
              center: const Alignment(-0.4, -0.5),
              colors: [
                const Color(0xFFFF5252).withValues(alpha: 0.95),
                const Color(0xFFE53935).withValues(alpha: 0.95),
                const Color(0xFF8B0000).withValues(alpha: 0.6),
              ],
              stops: const [0.0, 0.55, 1.0],
            ).createShader(Rect.fromCircle(center: Offset(bx, by), radius: puffR)));
        }

        // LAYER 4: Orange (gradient with glow)
        for (int i = 0; i < 11; i++) {
          final seed = i * 0.412;
          final ang = i * 3.14159 * 2 / 11 + 1.0;
          final distMult = 0.5 + (seed % 1) * 0.3;
          final dist = baseR * distMult;
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.85;
          final puffR = baseR * (0.38 + (seed % 1) * 0.22);
          canvas.drawCircle(Offset(bx, by), puffR, Paint()
            ..shader = RadialGradient(
              center: const Alignment(-0.3, -0.4),
              colors: [
                const Color(0xFFFFAB40).withValues(alpha: 0.98),
                const Color(0xFFFF6F00).withValues(alpha: 0.95),
                const Color(0xFFE65100).withValues(alpha: 0.7),
              ],
              stops: const [0.0, 0.5, 1.0],
            ).createShader(Rect.fromCircle(center: Offset(bx, by), radius: puffR))
            ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 1));
        }

        // LAYER 5: Yellow-orange (bright center highlight)
        for (int i = 0; i < 9; i++) {
          final seed = i * 0.318;
          final ang = i * 3.14159 * 2 / 9 + 1.4;
          final distMult = 0.35 + (seed % 1) * 0.25;
          final dist = baseR * distMult;
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.82;
          final puffR = baseR * (0.35 + (seed % 1) * 0.2);
          canvas.drawCircle(Offset(bx, by), puffR, Paint()
            ..shader = RadialGradient(
              center: const Alignment(-0.3, -0.5),
              colors: [
                const Color(0xFFFFE082),
                const Color(0xFFFFB300),
                const Color(0xFFFF8F00),
              ],
              stops: const [0.0, 0.6, 1.0],
            ).createShader(Rect.fromCircle(center: Offset(bx, by), radius: puffR)));
        }

        // LAYER 6: Bright yellow (inner core puffs)
        for (int i = 0; i < 7; i++) {
          final seed = i * 0.227;
          final ang = i * 3.14159 * 2 / 7 + 1.8;
          final distMult = 0.22 + (seed % 1) * 0.2;
          final dist = baseR * distMult;
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.8;
          final puffR = baseR * (0.3 + (seed % 1) * 0.15);
          canvas.drawCircle(Offset(bx, by), puffR, Paint()
            ..shader = RadialGradient(
              center: const Alignment(-0.2, -0.4),
              colors: [
                const Color(0xFFFFF59D),
                const Color(0xFFFFEB3B),
                const Color(0xFFFFC107),
              ],
              stops: const [0.0, 0.5, 1.0],
            ).createShader(Rect.fromCircle(center: Offset(bx, by), radius: puffR)));
        }

        // LAYER 7: White hot core (jagged + glow)
        final coreR = baseR * 0.4;
        // Outer glow
        canvas.drawCircle(Offset(cx, cy), coreR * 1.4, Paint()
          ..shader = RadialGradient(colors: [
            const Color(0xFFFFEB3B).withValues(alpha: 0.6),
            const Color(0xFFFF6F00).withValues(alpha: 0.3),
            Colors.transparent,
          ], stops: const [0.0, 0.6, 1.0])
            .createShader(Rect.fromCircle(center: Offset(cx, cy), radius: coreR * 1.4))
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 6));
        // Jagged core
        final corePath = Path();
        for (int i = 0; i <= 16; i++) {
          final ang = i * 3.14159 * 2 / 16;
          final spike = (i % 2 == 0) ? 1.0 : 0.7;
          final jitter = ((i * 7) % 10) / 100.0;
          final r = coreR * (spike + jitter);
          final x = cx + cos(ang) * r;
          final y = cy + sin(ang) * r;
          if (i == 0) { corePath.moveTo(x, y); } else { corePath.lineTo(x, y); }
        }
        corePath.close();
        canvas.drawPath(corePath, Paint()
          ..shader = RadialGradient(colors: [
            Colors.white,
            const Color(0xFFFFEB3B),
            const Color(0xFFFFA000).withValues(alpha: 0.8),
            Colors.transparent,
          ], stops: const [0.0, 0.4, 0.75, 1.0])
            .createShader(Rect.fromCircle(center: Offset(cx, cy), radius: coreR))
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 3));
        canvas.drawCircle(Offset(cx, cy), coreR * 0.5, Paint()..color = Colors.white);

        // LAYER 8: Sparks with glow
        for (int i = 0; i < 25; i++) {
          final seed = rng.nextDouble();
          final ang = rng.nextDouble() * 6.28;
          final dist = baseR * (0.9 + rng.nextDouble() * 1.0);
          final sx = cx + cos(ang) * dist;
          final sy = cy + sin(ang) * dist * 0.85;
          final ss = 1.5 + rng.nextDouble() * 3;
          final sa = (1 - pp * 0.5) * 0.95;
          canvas.drawCircle(Offset(sx, sy), ss * 2.5, Paint()
            ..color = const Color(0xFFFF4500).withValues(alpha: sa * 0.4)
            ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 3));
          canvas.drawCircle(Offset(sx, sy), ss, Paint()
            ..shader = RadialGradient(colors: [
              Colors.white,
              const Color(0xFFFFEB3B),
              const Color(0xFFFF6F00).withValues(alpha: 0.6),
            ]).createShader(Rect.fromCircle(center: Offset(sx, sy), radius: ss)));
        }
      } else {
        final pp = (p - 0.35) / 0.65;
        final baseR = w * 0.26 + pp * w * 0.08;
        final fade = 1 - pp * 0.6;
        // Dissolving smoke (gradient)
        for (int i = 0; i < 18; i++) {
          final seed = i * 0.71;
          final ang = i * 3.14159 * 2 / 18;
          final dist = baseR * (1.0 + (seed % 1) * 0.4);
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.9;
          final puffR = baseR * (0.5 + (seed % 1) * 0.3) * (1 + pp * 0.3);
          canvas.drawCircle(Offset(bx, by), puffR, Paint()
            ..shader = RadialGradient(
              center: const Alignment(0.0, 0.3),
              colors: [
                const Color(0xFF4A4A4A).withValues(alpha: 0.75 * fade),
                const Color(0xFF1A1A1A).withValues(alpha: 0.6 * fade),
                Colors.transparent,
              ],
            ).createShader(Rect.fromCircle(center: Offset(bx, by), radius: puffR))
            ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 8));
        }
        // Fading red
        for (int i = 0; i < 12; i++) {
          final seed = i * 0.53;
          final ang = i * 3.14159 * 2 / 12 + 0.3;
          final dist = baseR * (0.7 + (seed % 1) * 0.35);
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.88;
          canvas.drawCircle(Offset(bx, by), baseR * 0.45, Paint()
            ..shader = RadialGradient(colors: [
              const Color(0xFFE53935).withValues(alpha: 0.85 * fade),
              const Color(0xFF8B0000).withValues(alpha: 0.6 * fade),
            ]).createShader(Rect.fromCircle(center: Offset(bx, by), radius: baseR * 0.45)));
        }
        // Fading orange
        for (int i = 0; i < 9; i++) {
          final seed = i * 0.41;
          final ang = i * 3.14159 * 2 / 9 + 0.7;
          final dist = baseR * (0.45 + (seed % 1) * 0.3);
          final bx = cx + cos(ang) * dist;
          final by = cy + sin(ang) * dist * 0.85;
          canvas.drawCircle(Offset(bx, by), baseR * 0.4, Paint()
            ..shader = RadialGradient(colors: [
              const Color(0xFFFFB300).withValues(alpha: 0.8 * fade),
              const Color(0xFFFF6F00).withValues(alpha: 0.6 * fade),
            ]).createShader(Rect.fromCircle(center: Offset(bx, by), radius: baseR * 0.4)));
        }
      }
    }
    // PHASE 2 (0.35-0.80): SUSTAINED RISING FIRE
    if (progress >= 0.15 && progress < 0.80) {
      final p = (progress - 0.15) / 0.65;
      final fadeIn = p < 0.25 ? p / 0.25 : 1.0;
      final fadeOut = p > 0.75 ? (1 - p) / 0.25 : 1.0;
      final intensity = fadeIn * fadeOut;
      final baseY = h * 0.90;
      final maxHeight = h * 0.75;
      _drawRealFlame(canvas, cx, baseY, w * 0.28, maxHeight * 1.10 * intensity, intensity, rng, time);
      _drawRealFlame(canvas, cx - w * 0.18, baseY, w * 0.16, maxHeight * 0.85 * intensity, intensity * 0.9, rng, time + 1.3);
      _drawRealFlame(canvas, cx + w * 0.18, baseY, w * 0.16, maxHeight * 0.85 * intensity, intensity * 0.9, rng, time + 2.7);
      _drawRealFlame(canvas, cx - w * 0.30, baseY, w * 0.11, maxHeight * 0.60 * intensity, intensity * 0.7, rng, time + 4.1);
      _drawRealFlame(canvas, cx + w * 0.30, baseY, w * 0.11, maxHeight * 0.60 * intensity, intensity * 0.7, rng, time + 5.5);
      for (int i = 0; i < 25; i++) {
        final seed = rng.nextDouble();
        final ex = cx + (rng.nextDouble() - 0.5) * w * 0.7;
        final prog = ((time * 1.5 + seed) % 1.0);
        final ey = baseY - prog * maxHeight;
        final es = 1.5 + (1 - prog) * 2.5;
        final ea = (1 - prog) * intensity;
        canvas.drawCircle(Offset(ex, ey), es * 2.5, Paint()
          ..color = const Color(0xFFFF4500).withValues(alpha: ea * 0.4)
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 3));
        canvas.drawCircle(Offset(ex, ey), es, Paint()
          ..color = const Color(0xFFFFEB3B).withValues(alpha: ea));
        if (es > 2.5) {
          canvas.drawCircle(Offset(ex, ey), es * 0.4, Paint()
            ..color = Colors.white.withValues(alpha: ea * 0.9));
        }
      }
      canvas.drawCircle(Offset(cx, baseY), w * 0.28, Paint()
        ..shader = RadialGradient(colors: [
          const Color(0xFFFF6B00).withValues(alpha: 0.8 * intensity),
          const Color(0xFFFF4500).withValues(alpha: 0.4 * intensity),
          Colors.transparent,
        ]).createShader(Rect.fromCircle(center: Offset(cx, baseY), radius: w * 0.28))
        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 15));
    }
    // PHASE 3 (0.80-1.0): SMOKE
    if (progress >= 0.75) {
      final p = (progress - 0.75) / 0.25;
      final baseY = h * 0.90;
      if (p < 0.35) {
        final fireFade = 1 - p / 0.35;
        _drawRealFlame(canvas, cx, baseY, w * 0.16, h * 0.4 * fireFade, fireFade * 0.8, rng, time);
        _drawRealFlame(canvas, cx - w * 0.12, baseY, w * 0.09, h * 0.25 * fireFade, fireFade * 0.6, rng, time + 1);
        _drawRealFlame(canvas, cx + w * 0.12, baseY, w * 0.09, h * 0.25 * fireFade, fireFade * 0.6, rng, time + 2);
      }
      for (int i = 0; i < 18; i++) {
        final seed = rng.nextDouble();
        final sx = cx + (rng.nextDouble() - 0.5) * w * 0.7;
        final prog = ((time * 0.4 + seed) % 1.0);
        final sy = baseY - prog * h * 0.95;
        final ss = 12 + prog * 35;
        final sa = sin(prog * 3.14159) * 0.55 * (0.6 + 0.4 * (1 - p));
        final sway = sin(time * 1.5 + seed * 6) * 8;
        canvas.drawCircle(Offset(sx + sway, sy), ss, Paint()
          ..shader = RadialGradient(colors: [
            const Color(0xFF5A5A5A).withValues(alpha: sa),
            const Color(0xFF2A2A2A).withValues(alpha: sa * 0.5),
            Colors.transparent,
          ]).createShader(Rect.fromCircle(center: Offset(sx + sway, sy), radius: ss))
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 10));
      }
    }
  }

  void _drawRealFlame(Canvas canvas, double baseX, double baseY, double baseW, double height, double intensity, Random rng, double t) {
    if (intensity <= 0.01 || height <= 1) return;
    for (int layer = 0; layer < 4; layer++) {
      final layerH = height * (1 - layer * 0.18);
      final layerW = baseW * (1 - layer * 0.15);
      final alpha = (0.85 - layer * 0.15) * intensity;
      final color = layer == 0
          ? const Color(0xFFD32F2F)
          : layer == 1
              ? const Color(0xFFFF6B00)
              : layer == 2
                  ? const Color(0xFFFFC107)
                  : Colors.white;
      final wobble1 = sin(t * 5 + layer * 1.3) * baseW * 0.4;
      final wobble2 = cos(t * 6.5 + layer * 2.1) * baseW * 0.25;
      final path = Path();
      path.moveTo(baseX - layerW, baseY);
      path.quadraticBezierTo(
        baseX - layerW * 0.8 + wobble1,
        baseY - layerH * 0.4,
        baseX - layerW * 0.3 + wobble2,
        baseY - layerH * 0.7,
      );
      path.quadraticBezierTo(
        baseX + wobble1,
        baseY - layerH * 1.05,
        baseX + layerW * 0.15 + wobble2,
        baseY - layerH * 0.95,
      );
      path.quadraticBezierTo(
        baseX + layerW * 0.8 + wobble1,
        baseY - layerH * 0.4,
        baseX + layerW,
        baseY,
      );
      path.close();
      canvas.drawPath(path, Paint()
        ..shader = LinearGradient(
          begin: Alignment.bottomCenter,
          end: Alignment.topCenter,
          colors: [
            color.withValues(alpha: alpha),
            color.withValues(alpha: alpha * 0.5),
            color.withValues(alpha: 0),
          ],
        ).createShader(Rect.fromLTWH(baseX - layerW, baseY - layerH, layerW * 2, layerH))
        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 2.5));
    }
  }

  void _paintGasEvolution(Canvas canvas, double w, double h) {
    if (reaction == null || reaction!.gasEvolution == null) return;
    final top = h * (1 - 0.82 * item.fillRatio) - h * 0.03;
    final rng = Random(23);
    for (int i = 0; i < 10; i++) {
      final bx = rng.nextDouble() * w;
      final speed = 0.4 + rng.nextDouble() * 0.5;
      final progress = (time * speed + rng.nextDouble()) % 1.0;
      final by = h - progress * h * 1.2;
      if (by > top + 5) continue;
      final r = 2 + rng.nextDouble() * 3.5;
      canvas.drawCircle(Offset(bx, by), r,
        Paint()..color = Colors.white.withValues(alpha: 0.5 * (1 - progress)));
      canvas.drawCircle(Offset(bx, by), r,
        Paint()..style = PaintingStyle.stroke..strokeWidth = 0.8
          ..color = Colors.white.withValues(alpha: 0.8 * (1 - progress)));
    }
  }

  void _paintSmoke(Canvas canvas, double w, double h) {
    if (reaction == null || !reaction!.producesSmoke) return;
    final rng = Random(31);
    for (int i = 0; i < 6; i++) {
      final bx = w * 0.4 + rng.nextDouble() * w * 0.2;
      final progress = (time * 0.35 + rng.nextDouble()) % 1.0;
      final by = -20 - progress * h * 0.6;
      final r = 6 + progress * 20;
      canvas.drawCircle(Offset(bx, by), r,
        Paint()
          ..color = Colors.white.withValues(alpha: (1 - progress) * 0.35)
          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 8));
    }
  }
  void _paintHeatingEffect(Canvas canvas, double w, double h) {
    final he = item.activeHeatingEffect;
    if (he == null) return;
    final top = h * (1 - 0.82 * item.fillRatio) - h * 0.03;
    final rng = Random(37);

    if (he.bubbles) {
      for (int i = 0; i < 14; i++) {
        final bx = rng.nextDouble() * w;
        final speed = 0.5 + rng.nextDouble() * 0.6;
        final progress = (time * speed + rng.nextDouble()) % 1.0;
        final by = h - progress * (h - top);
        final r = 2 + rng.nextDouble() * 3.5;
        canvas.drawCircle(Offset(bx, by), r,
          Paint()..color = Colors.white.withValues(alpha: 0.55 * (1 - progress * 0.5)));
        canvas.drawCircle(Offset(bx, by), r,
          Paint()..style = PaintingStyle.stroke..strokeWidth = 0.7
            ..color = Colors.white.withValues(alpha: 0.85 * (1 - progress * 0.5)));
      }
    }

    if (he.smoke || he.brownFumes) {
      final smokeCol = he.brownFumes ? const Color(0xFF8D6E63) : Colors.white;
      for (int i = 0; i < 8; i++) {
        final bx = w * 0.35 + rng.nextDouble() * w * 0.3;
        final progress = (time * 0.4 + rng.nextDouble()) % 1.0;
        final by = -10 - progress * h * 0.8;
        final r = 5 + progress * 22;
        canvas.drawCircle(Offset(bx, by), r,
          Paint()
            ..color = smokeCol.withValues(alpha: (1 - progress) * 0.5)
            ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 8));
      }
    }
  }
  void _paintThermometer(Canvas canvas, double w, double h) {
    final tx = w * 0.98;
    final ty = h * 0.30;
    const tw = 6.0;
    final th = h * 0.55;

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(tx, ty, tw, th),
        const Radius.circular(5)),
      Paint()..color = Colors.white.withValues(alpha: 0.95));

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(tx, ty, tw, th),
        const Radius.circular(5)),
      Paint()
        ..color = const Color(0xFF37474F)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.2);

    final level = ((item.temperature - 0) / 150).clamp(0.05, 1.0);
    final mercuryH = th * 0.78 * level;
    final mercuryColor = item.temperature >= 60
        ? const Color(0xFFE53935)
        : item.temperature <= 10
            ? const Color(0xFF1E88E5)
            : const Color(0xFFB85450);

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(tx + 2, ty + th - mercuryH - 1, tw - 4, mercuryH),
        const Radius.circular(2)),
      Paint()..color = mercuryColor);

    canvas.drawCircle(Offset(tx + tw / 2, ty + th + 6), 7,
      Paint()..color = mercuryColor);
    canvas.drawCircle(Offset(tx + tw / 2, ty + th + 6), 7,
      Paint()
        ..color = const Color(0xFF37474F)
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1);

    for (int i = 0; i < 6; i++) {
      final y = ty + th * 0.1 + (th * 0.78 * i / 5);
      final isMajor = i == 0 || i == 5;
      canvas.drawLine(
        Offset(tx - (isMajor ? 5 : 3), y),
        Offset(tx, y),
        Paint()
          ..color = const Color(0xFF37474F).withValues(alpha: 0.8)
          ..strokeWidth = isMajor ? 1.2 : 0.7);
    }

    final tempTp = TextPainter(
      text: TextSpan(
        text: '${item.temperature.toInt()}°C',
        style: const TextStyle(
          fontSize: 10, color: Colors.white,
          fontWeight: FontWeight.w800, letterSpacing: 0.3)),
      textDirection: TextDirection.ltr,
    )..layout();
    final pillW = tempTp.width + 8;
    final pillH = tempTp.height + 4;
    final pillX = tx + tw / 2 - pillW / 2;
    final pillY = ty - pillH - 4;
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(pillX, pillY, pillW, pillH),
        const Radius.circular(4)),
      Paint()..color = item.temperature >= 60
          ? const Color(0xFFE53935)
          : item.temperature <= 10
              ? const Color(0xFF1E88E5)
              : const Color(0xFF37474F));
    tempTp.paint(canvas, Offset(pillX + 4, pillY + 2));
  }

