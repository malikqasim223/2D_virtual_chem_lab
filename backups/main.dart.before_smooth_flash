  void endChemicalDrag() {
    dragOverlay?.remove();
    dragOverlay = null;
    final hit = _equipUnderPoint(dragPos);
    if (hit != null && draggingChemical != null) _pourInto(hit, draggingChemical!);
    setState(() { draggingChemical = null; hoveredEquipId = null; });
